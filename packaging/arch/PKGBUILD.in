# Maintainer: Piotr Lewandowski <piotr.petexy@gmail.com>

pkgname=distribumpy
pkgver=@VERSION@
pkgrel=1
pkgdesc='A Flatpak store in the LineXinBar design language, shown as Software Hub'
arch=('x86_64' 'aarch64')
url='https://github.com/Petexy/distribumpy'
license=('GPL-3.0-only')
# flatpak is a runtime dependency as well as a build one: this is a front end
# for libflatpak, and there is nothing for it to do without one.
#
# libxkbcommon, alsa-lib and systemd-libs (libudev) are the keyboard, the
# interface sounds and the game controllers, all three linked outright. wayland
# is the window, opened by name at run time and so invisible to anything that
# reads the ELF. libglvnd is the EGL fallback wgpu takes on a machine with no
# Vulkan driver.
depends=('flatpak' 'glibc' 'gcc-libs' 'glib2' 'wayland' 'libxkbcommon' 'libglvnd'
         'alsa-lib' 'systemd-libs')
# The toolkit is a *build* dependency and not a runtime one, which is the thing
# about this package that looks like a mistake and is not. `lxb-app` is a Rust
# path dependency: cargo compiles those sources into this binary, so what comes
# out links no liblxb_*.so at all and runs on a machine that has never heard of
# the toolkit. It is versioned all the same — this is built against one release
# of the language, not against whichever is lying about.
makedepends=('cargo' 'pkgconf' 'lxb-toolkit>=@TOOLKIT_VERSION@')
# The Links page hands an address to whatever this desktop opens addresses
# with, which is the only thing here that is not done in-process.
optdepends=("xdg-utils: opening a project's website, help and bug tracker"
            'vulkan-icd-loader: draw through Vulkan rather than the EGL fallback')
options=(!lto)
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')
_distribumpy_rustflags="${RUSTFLAGS:-}"

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    export RUSTFLAGS="$_distribumpy_rustflags --remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"
    cargo build --frozen --release
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    # `cargo test` already builds in the dev profile. Nothing here may pin an
    # optimisation level: RUSTFLAGS is appended after the profile's own flags
    # and wins.
    export RUSTFLAGS="$_distribumpy_rustflags --remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"
    cargo test --frozen
}

package() {
    cd "$pkgname-$pkgver"
    ./packaging/install.sh \
        --destdir "$pkgdir" \
        --prefix /usr \
        --target-dir target

    install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm0644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
