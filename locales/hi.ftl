count-repositories = { $count ->
    [one] { $count } रिपॉज़िटरी
   *[other] { $count } रिपॉज़िटरी
    }
count-updates-waiting = { $count ->
    [one] { $count } अपडेट प्रतीक्षा में
   *[other] { $count } अपडेट प्रतीक्षा में
    }
count-apps-installed = { $count ->
    [one] { $count } ऐप्लिकेशन इंस्टॉल है
   *[other] { $count } ऐप्लिकेशन इंस्टॉल हैं
    }
count-apps-found = { $count ->
    [one] { $count } ऐप्लिकेशन मिला
   *[other] { $count } ऐप्लिकेशन मिले
    }
count-apps = { $count ->
    [one] { $count } ऐप्लिकेशन
   *[other] { $count } ऐप्लिकेशन
    }
rating-reviews = 5 में से { $rating }  ·  { $reviews ->
    [one] { $reviews } समीक्षा
   *[other] { $reviews } समीक्षाएँ
    }
permission-changed = { $app } के लिए { $permission } { $state ->
    [on] चालू
   *[off] बंद
    } है।
